{
  "name": "inovanti-bank/inovanti-holydays",
  "description": "Pacote para gerenciamento de feriados fixos e móveis em Laravel 11+",
  "type": "library",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "keywords": [
    "laravel",
    "feriados",
    "holidays",
    "calendar",
    "inovanti"
  ],
  "authors": [
    {
      "name": "inovanti Ip",
      "email": "dev@inovanti.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "InovantiBank\\Holydays\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "InovantiBank\\Holydays\\HolydaysServiceProvider"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "mockery/mockery": "^2.0",
    "laravel/pint": "^1.19"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "unit": "vendor/bin/phpunit --testsuite=Unit",
    "pint": "vendor/bin/pint"
  }
}
